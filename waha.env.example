# WAHA container environment for Podman
# Use with: podman run --env-file ./waha.env ...

# WAHA HTTP API
WHATSAPP_API_PORT=3000
WAHA_API_KEY=secret123

# Dashboard login
WAHA_DASHBOARD_ENABLED=true
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=admin123

# Default WhatsApp engine/session behavior
WHATSAPP_DEFAULT_ENGINE=GOWS
WAHA_LOG_LEVEL=info
WAHA_LOG_FORMAT=PRETTY

# Global webhook for all sessions
# From inside Podman, this points back to the host machine backend.
WHATSAPP_HOOK_URL=http://host.containers.internal:4000/api/webhooks/whatsapp
WHATSAPP_HOOK_EVENTS=message
WHATSAPP_HOOK_RETRIES_POLICY=linear
WHATSAPP_HOOK_RETRIES_DELAY_SECONDS=2
WHATSAPP_HOOK_RETRIES_ATTEMPTS=4

# Media handling
WHATSAPP_DOWNLOAD_MEDIA=true
WHATSAPP_FILES_FOLDER=/tmp/whatsapp-files
WHATSAPP_FILES_LIFETIME=0
