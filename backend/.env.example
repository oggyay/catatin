# ==============================
# CatatIN Backend Environment
# ==============================

# Server
PORT=4000
NODE_ENV=development
APP_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/catatin?schema=public

# Redis (OTP/cache)
REDIS_URL=redis://localhost:6379

# JWT / Session
JWT_SECRET=change-this-to-a-secure-random-secret
JWT_EXPIRES_IN=7d

# OTP Settings
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_COUNT=3
OTP_RATE_LIMIT_WINDOW_MINUTES=15

# WhatsApp Provider (adapter): waha | wa-akg | mock
WA_PROVIDER=mock

# WAHA provider (https://waha.devlike.pro/)
WAHA_BASE_URL=http://localhost:3000
WAHA_SESSION=default
WAHA_API_KEY=your-waha-api-key

# WA-AKG provider (https://wa-akg or akg gateway)
WA_AKG_BASE_URL=
WA_AKG_API_KEY=
WA_AKG_DEVICE_ID=

# AI Parser (OpenAI)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
AI_PARSER_ENABLED=true

# WhatsApp pending confirmation (minutes)
WA_PENDING_EXPIRES_MINUTES=10

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Admin bootstrap
PLATFORM_ADMIN_WHATSAPP=6289999999999

# Demo user WhatsApp (dipakai oleh seed)
DEMO_USER_WHATSAPP=6281234567890
